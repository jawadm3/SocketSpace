    "./internal-events": "./src/internal-events.ts",
    "./limits": "./src/limits.ts",
    "./markdown": "./src/markdown.ts",
    "./media": "./src/media.ts",
    "./primitives": "./src/primitives.ts",
    "./profile": "./src/profile.ts",
    "./realtime-token": "./src/realtime-token.ts",
    "./rooms": "./src/rooms.ts",
    "./text": "./src/text.ts"
