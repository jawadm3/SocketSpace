{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "//#lint:root": {
      "inputs": ["scripts/**", "eslint.config.mjs", "vitest.config.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["TEST_DATABASE_URL", "REDIS_TEST_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
