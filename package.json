{
  "name": "socketspace",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "SocketSpace v2: a production-grade real-time chat platform.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.8.0"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint scripts eslint.config.mjs vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint lint:root typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "node scripts/tools/gitleaks.mjs git --redact --no-banner -v .",
    "secrets:staged": "node scripts/tools/gitleaks.mjs git --pre-commit --staged --redact --no-banner -v"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^22",
    "eslint": "^10",
    "globals": "^17",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vitest": "^5"
  }
}
