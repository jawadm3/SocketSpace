# SocketSpace web app: environment variables.
#
# Copy this file to apps/web/.env.local for local development (never commit .env.local).
# In production, set these in the Vercel dashboard (Project > Settings > Environment Variables).
# This file lists names and descriptions only. Never put real values in it.
# `pnpm setup:local` fills a local .env.local with safe development values for you.

# --- Database -----------------------------------------------------------------------------------
# PostgreSQL connection string. Locally: the server started by `pnpm db:start`
# (postgres://socketspace@127.0.0.1:54329/socketspace). In production: Neon's pooled string.
DATABASE_URL=
# Connections per server instance (default 3; keep small on serverless hosting).
DB_POOL_MAX=

# --- Sign-in (Better Auth) ------------------------------------------------------------------------
# A long random secret (at least 32 characters) used to sign sessions and encrypt keys.
# Changing it signs everyone out and invalidates the realtime signing keys.
BETTER_AUTH_SECRET=
# The public address of this web app, for example https://socketspace.vercel.app
BETTER_AUTH_URL=
# Check new passwords against Have I Been Pwned (true/false, default true). Only the first five
# characters of the password's SHA-1 hash are sent.
HIBP_ENABLED=
# Rate-limit sign-in requests (true/false, default true). Only switch off for special test runs.
AUTH_RATE_LIMIT_ENABLED=
# Request header carrying the visitor's IP address, used by the per-IP sign-in limits (default
# x-forwarded-for). It must be a header your hosting platform sets itself: Vercel overwrites
# x-forwarded-for, so it is safe there. A self-hosted `next start` keeps whatever the visitor
# sends, so put a proxy in front that overwrites it (the per-account lockout still applies).
CLIENT_IP_HEADER=

# --- Social sign-in (optional; a provider appears only when both values are set) -----------------
# Callback URL to register with each provider: {BETTER_AUTH_URL}/api/auth/callback/{provider}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Microsoft directory: "common" (default) allows personal and work accounts.
MICROSOFT_TENANT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Passkeys (optional overrides) -----------------------------------------------------------------
# Defaults: the host name of BETTER_AUTH_URL, and "SocketSpace".
PASSKEY_RP_ID=
PASSKEY_RP_NAME=

# --- Email ------------------------------------------------------------------------------------------
# resend (production), file (local "mail catcher", default) or memory (automated tests).
EMAIL_DRIVER=
# Sender, for example: SocketSpace <no-reply@your-subdomain.is-a.dev>
EMAIL_FROM=
# Resend API key (required when EMAIL_DRIVER=resend).
RESEND_API_KEY=
# Folder for the file driver (default <repo>/.cache/dev-mail). Open /dev/mail to read the emails.
DEV_MAIL_DIR=

# --- Realtime server ----------------------------------------------------------------------------
# Where browsers connect for live updates, for example https://socketspace-rt.onrender.com
REALTIME_PUBLIC_URL=
# Where this app sends internal events (default: REALTIME_PUBLIC_URL).
REALTIME_INTERNAL_URL=
# Shared secret (at least 32 characters) for signing internal events. Must match the realtime
# server's INTERNAL_EVENTS_SECRET.
INTERNAL_EVENTS_SECRET=

# --- Pictures (uploads) --------------------------------------------------------------------------
# Where re-encoded pictures are stored: vercel-blob (production), local (a folder on this
# computer; default) or memory (automated tests). Production on Vercel must use vercel-blob.
STORAGE_DRIVER=
# Vercel Blob read-write token (required when STORAGE_DRIVER=vercel-blob). Create a PRIVATE Blob
# store in the Vercel dashboard (Storage > Create > Blob); Vercel then sets this variable itself.
BLOB_READ_WRITE_TOKEN=
# Folder for the local driver (default <repo>/.cache/uploads).
STORAGE_LOCAL_DIR=

# --- Link previews -------------------------------------------------------------------------------
# Fetch text previews of links on the server (true/false, default true).
LINK_PREVIEWS_ENABLED=
# Local testing only. Host names the preview fetcher reaches at a local address, written as
# name=127.0.0.1:port and separated by commas. The app refuses to start with this set unless
# BETTER_AUTH_URL is on localhost. Leave empty everywhere else.
LINK_PREVIEW_DEV_HOSTS=

# --- Random-match mode ----------------------------------------------------------------------------
# The kill switch: false hides random chat and refuses its pages and actions (true/false, default
# true). Set the same value on the realtime server, which then refuses every random-chat event.
RANDOM_MODE_ENABLED=

# --- Logging ---------------------------------------------------------------------------------------
# fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=
