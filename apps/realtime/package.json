{
  "name": "@socketspace/realtime",
  "version": "0.0.0",
  "private": true,
  "description": "The long-running real-time server: authenticated Socket.IO connections, message delivery, health and metrics.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socketspace/db": "workspace:*",
    "@socketspace/shared": "workspace:*",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@socketspace/config": "workspace:*",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2"
  }
}
