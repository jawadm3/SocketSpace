# SocketSpace realtime server: environment variables.
#
# Local development: `pnpm setup:local` creates apps/realtime/.env.local with safe values
# (never commit it). In production, set these in the Render dashboard (Service > Environment).
# This file lists names and descriptions only. Never put real values in it.

# --- Network ------------------------------------------------------------------------------------
# Port to listen on (default 4000; Render sets PORT itself).
PORT=
# Address to listen on (default 0.0.0.0, every interface).
HOST=
# Reverse proxies in front of the server (default 0; Render: 1). Used to read the client's IP from
# X-Forwarded-For safely. Wrong values let clients choose their own IP for the connection caps.
TRUST_PROXY_HOPS=

# --- Database -----------------------------------------------------------------------------------
# PostgreSQL connection string. Locally: postgres://socketspace@127.0.0.1:54329/socketspace.
# In production: Neon's pooled connection string.
DATABASE_URL=
# Connections in the pool (default 5).
DB_POOL_MAX=
# Close idle connections after this many milliseconds (default 60000), so Neon can sleep.
DB_IDLE_TIMEOUT_MS=

# --- Who may connect ----------------------------------------------------------------------------
# Browser origins allowed to connect, comma-separated, for example https://socketspace.vercel.app
WEB_ORIGINS=
# The web app's public signing keys: {web app URL}/api/auth/jwks
AUTH_JWKS_URL=
# The web app's origin (the `iss` claim in connection tokens), for example https://socketspace.vercel.app
AUTH_ISSUER=
# Expected `aud` claim (default socketspace-realtime; change only together with the web app).
REALTIME_TOKEN_AUDIENCE=
# Connection caps (defaults 10 per person, 20 per IP address, 30 new connections per IP per minute).
MAX_CONNECTIONS_PER_USER=
MAX_CONNECTIONS_PER_IP=
NEW_CONNECTIONS_PER_IP_PER_MINUTE=

# --- Secrets ------------------------------------------------------------------------------------
# Shared secret (at least 32 characters) for internal events from the web app. Must match the web
# app's INTERNAL_EVENTS_SECRET.
INTERNAL_EVENTS_SECRET=
# Bearer token (at least 24 characters) protecting GET /metrics.
METRICS_TOKEN=

# --- Scaling (optional) -------------------------------------------------------------------------
# Redis connection string. Set only when running two or more instances (decision D-010).
REDIS_URL=
# Socket.IO's short-drop recovery (true/false, default true; switched off automatically with Redis).
CONNECTION_RECOVERY=

# --- Random-match mode --------------------------------------------------------------------------
# The kill switch: false refuses every random-chat event (true/false, default true). Set the same
# value in the web app, which then hides the pages.
RANDOM_MODE_ENABLED=

# --- Operations ---------------------------------------------------------------------------------
# Milliseconds allowed for a clean shutdown on SIGTERM (default 10000).
SHUTDOWN_GRACE_MS=
# fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=
